{$SITE_ADDRESS:http://localhost} {
	encode zstd gzip
	log {
		output stdout
		format json
	}

	# Health is used inside Docker and is not part of the public API.
	redir /grafana /grafana/ 308
	handle /grafana/* {
		@grafana_metrics path /grafana/metrics /grafana/metrics/*
		respond @grafana_metrics 404
		reverse_proxy grafana:3000
	}

	@actuator path /actuator /actuator/*
	handle @actuator {
		respond 404
	}

	handle {
		reverse_proxy app:8081
	}
}
