# Defaults for a local Docker stack. Replace the password before public deployment.
DB_USERNAME=radioparadise
DB_PASSWORD=radioparadise
# Match the timezone used by existing song records and your host development JVM.
APP_TIMEZONE=Europe/Istanbul

# Local HTTP entrypoint: http://localhost:8080
SITE_ADDRESS=http://localhost
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# For a server, use a domain pointing to the server and set:
# SITE_ADDRESS=radio.example.com
# BIND_ADDRESS=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443
