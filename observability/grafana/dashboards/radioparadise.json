      },
      "gridPos": {
        "x": 16,
        "y": 21,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_deadlocks{job=\"postgres\",datname=\"radioparadise\"}[5m])",
          "legendFormat": "Deadlocks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "PostgreSQL transactions / second",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_xact_commit{job=\"postgres\",datname=\"radioparadise\"}[5m])",
          "legendFormat": "Commits"
        },
        {
          "refId": "B",
          "expr": "rate(pg_stat_database_xact_rollback{job=\"postgres\",datname=\"radioparadise\"}[5m])",
          "legendFormat": "Rollbacks"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "PostgreSQL buffer cache hit ratio",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * rate(pg_stat_database_blks_hit{job=\"postgres\",datname=\"radioparadise\"}[5m]) / clamp_min(rate(pg_stat_database_blks_hit{job=\"postgres\",datname=\"radioparadise\"}[5m]) + rate(pg_stat_database_blks_read{job=\"postgres\",datname=\"radioparadise\"}[5m]),0.001)",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "title": "PostgreSQL database size",
