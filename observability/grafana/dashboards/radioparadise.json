          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "PostgreSQL deadlocks / second",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
