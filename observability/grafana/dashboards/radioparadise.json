        }
      }
    },
    {
      "id": 19,
      "title": "Collector successful / failed polls per second",
      "description": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(channel,outcome) (rate(radioparadise_collector_polls_total{job=\"app\"}[5m]))",
          "legendFormat": "Channel {{channel}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
