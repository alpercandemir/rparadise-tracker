  "templating": {
    "list": [
      {
        "name": "endpoint",
        "label": "API endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_requests_seconds_count{job=\"app\",uri=~\"/api/.*\"}, uri)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "upstream",
        "label": "RP host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
