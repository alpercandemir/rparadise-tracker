    {
      "id": 7,
      "title": "CPU busy by mode",
      "description": "Steal indicates hypervisor contention; iowait indicates tasks waiting for I/O.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * avg by(mode) (rate(node_cpu_seconds_total{job=\"node\",mode!=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Load normalized by CPU count",
      "description": "Sustained values above 1 indicate more runnable/I/O-wait tasks than logical CPUs.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_load1{job=\"node\"} / on(instance) group_left count by(instance) (node_cpu_seconds_total{job=\"node\",mode=\"idle\"})",
          "legendFormat": "1 min"
        },
        {
          "refId": "B",
          "expr": "node_load5{job=\"node\"} / on(instance) group_left count by(instance) (node_cpu_seconds_total{job=\"node\",mode=\"idle\"})",
          "legendFormat": "5 min"
        },
        {
          "refId": "C",
          "expr": "node_load15{job=\"node\"} / on(instance) group_left count by(instance) (node_cpu_seconds_total{job=\"node\",mode=\"idle\"})",
          "legendFormat": "15 min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
