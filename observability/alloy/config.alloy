logging {
  level = "warn"
}

// Docker json-file logs only. No Docker control socket is exposed to Alloy.
local.file_match "docker" {
  path_targets = [{"__path__" = "/var/lib/docker/containers/*/*-json.log", "job" = "docker", "host" = "radioparadise"}]
  sync_period = "15s"
}

loki.source.file "docker" {
  targets    = local.file_match.docker.targets
  forward_to = [loki.process.docker.receiver]
}

loki.process "docker" {
  forward_to = [loki.write.local.receiver]
  stage.json {
    expressions = {
      log     = "log",
      stream  = "stream",
      time    = "time",
      service = "attrs.\"com.docker.compose.service\"",
      project = "attrs.\"com.docker.compose.project\"",
    }
  }
  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }
  stage.labels {
    values = {service = "", project = "", stream = ""}
  }
  stage.output {
    source = "log"
  }
  // Keep Java exceptions together. filename is still present here, so lines
  // from separate container files cannot be merged into the same event.
  stage.match {
    selector = "{service=\"app\"}"
    stage.multiline {
      firstline     = "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}"
      max_wait_time = "3s"
      max_lines     = 256
    }
    stage.regex {
      expression = "(?s)^[^\\n]*?\\s(?P<level>TRACE|DEBUG|INFO|WARN|ERROR|FATAL)\\s"
    }
    stage.template {
      source   = "level"
      template = "{{ ToLower .Value }}"
    }
    stage.labels {
      values = {level = ""}
    }
  }
  // Container IDs stay out of the index; service labels survive recreation.
  stage.label_drop {
    values = ["filename"]
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
